{
  "model": "catboost_classifier",
  "config": {
    "seed": 42,
    "split": "stratified_group",
    "n_splits": 5,
    "models": [
      "dummy",
      "logreg_tabular",
      "logreg_text",
      "catboost_regressor",
      "catboost_classifier"
    ],
    "bootstrap_repeats": 500,
    "logreg": {
      "C": 1.0,
      "max_iter": 1500
    },
    "text": {
      "max_features": 20000
    },
    "catboost": {
      "iterations": 400,
      "depth": 6,
      "learning_rate": 0.05,
      "l2_leaf_reg": 3,
      "thread_count": 2
    }
  },
  "environment": {
    "python": "3.13.18",
    "packages": {
      "numpy": "2.1.3",
      "pandas": "2.3.3",
      "scikit-learn": "1.6.1",
      "scipy": "1.16.3",
      "catboost": "1.2.10",
      "matplotlib": "3.10.0",
      "PyYAML": "6.0.3",
      "joblib": "1.6.0"
    }
  }
}